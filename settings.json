{
  "schema_name": "comsol_mcp.settings",
  "schema_version": "1.2.0",
  "profile": {
    "name": "core"
  },
  "runtime": {
    "directory": "%PROGRAMDATA%/comsol_mcp/runtime",
    "jobs_directory": null
  },
  "paths": {
    "model_read_roots": [
      "%LOCALAPPDATA%/comsol_mcp/models"
    ],
    "artifact_write_root": "%PROGRAMDATA%/comsol_mcp/artifacts"
  },
  "shared_server": {
    "enabled": false
  },
  "evidence_integrity": {
    "checks": {
      "outcome_contract_validation": true,
      "artifact_chain_verification": true,
      "summary_claim_verification": true,
      "producer_driver_compatibility": true
    }
  },
  "semantic_docs": {
    "enabled": false,
    "root": null,
    "lexical_index": null,
    "model_path": null
  },
  "ownership": {
    "owner": null
  },
  "java": {
    "java_home": null,
    "jdk_home": null
  },
  "comsol": {
    "installation_root": null
  },
  "gui": {
    "language": "zh-cn",
    "scale": "system"
  }
}
